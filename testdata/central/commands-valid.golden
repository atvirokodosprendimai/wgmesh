=== direct calls ===
-- direct --
$ wg set wg0 peer OLDPEERKEYOLDPEERKEYOLDPEERKEYOLDPEERKEY00= remove
$ wg set wg0 peer NEWPEERKEYNEWPEERKEYNEWPEERKEYNEWPEERKEY00= preshared-key /dev/stdin endpoint 198.51.100.7:51820 allowed-ips 10.99.0.7/32,192.168.70.0/24 persistent-keepalive 25
< PSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSK0=
$ wg set wg0 peer MODPEERKEYMODPEERKEYMODPEERKEYMODPEERKEY00=
$ cat > /etc/wireguard/wg0.conf && chmod 600 /etc/wireguard/wg0.conf
< [Interface]
< Address = 10.99.0.5/16
< ListenPort = 51820
< PrivateKey = DIRECTPRIVATEKEYDIRECTPRIVATEKEYDIRECTPRIV0=
< PostUp = ip route add 192.168.10.0/24 via 10.99.0.1 dev %i || true
< PostUp = ip route add 192.168.20.0/24 via 10.99.0.2 dev %i || true
< PreDown = ip route del 192.168.10.0/24 via 10.99.0.1 dev %i || true
< PreDown = ip route del 192.168.20.0/24 via 10.99.0.2 dev %i || true
< PostUp = sysctl -w net.ipv4.ip_forward=1
< 
< [Peer]
< PublicKey = PEERONEPEERONEPEERONEPEERONEPEERONEPEER00=
< Endpoint = 198.51.100.1:51820
< AllowedIPs = 10.99.0.1/32, 192.168.10.0/24
< PersistentKeepalive = 5
< 
< [Peer]
< PublicKey = PEERTWOPEERTWOPEERTWOPEERTWOPEERTWOPEER00=
< AllowedIPs = 10.99.0.2/32
< 
$ wg set wg0 peer OLDPEERKEYOLDPEERKEYOLDPEERKEYOLDPEERKEY00= remove
$ wg set wg0 peer NEWPEERKEYNEWPEERKEYNEWPEERKEYNEWPEERKEY00= preshared-key /dev/stdin endpoint 198.51.100.7:51820 allowed-ips 10.99.0.7/32,192.168.70.0/24 persistent-keepalive 25
< PSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSKPSK0=
$ wg set wg0 peer MODPEERKEYMODPEERKEYMODPEERKEYMODPEERKEY00=
$ wg show wg0 dump 2>/dev/null || true
$ ip route del 10.5.0.0/24 via 10.99.0.3 dev wg0 2>/dev/null || true
$ ip route del 10.6.0.0/24 dev wg0 2>/dev/null || true
$ ip route add 10.7.0.0/24 via 10.99.0.1 dev wg0 || ip route replace 10.7.0.0/24 via 10.99.0.1 dev wg0
$ ip route add 10.8.0.0/24 dev wg0 || ip route replace 10.8.0.0/24 dev wg0
$ sysctl -w net.ipv4.ip_forward=1 > /dev/null
$ ip -6 -o addr show to fd00:1::/64
$ ip -6 route add fd00:1::/64 dev eth0 proto kernel metric 256
