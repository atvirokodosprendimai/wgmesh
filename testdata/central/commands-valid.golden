=== deploy, fresh nodes ===
-- alpha --
$ hostname
$ hostname -f
$ curl -s -4 --max-time 5 ifconfig.me || curl -s -4 --max-time 5 icanhazip.com || true
$ which wg
$ apt update -qq
$ DEBIAN_FRONTEND=noninteractive apt install -y -qq wireguard wireguard-tools
$ modprobe wireguard || true
$ wg show wg0 dump 2>/dev/null || true
$ cat > /etc/wireguard/wg0.conf && chmod 600 /etc/wireguard/wg0.conf
< [Interface]
< Address = 10.99.0.1/16
< ListenPort = 51820
< PrivateKey = ALPHAPRIVATEKEYALPHAPRIVATEKEYALPHAPRIVATE0=
< PostUp = sysctl -w net.ipv4.ip_forward=1
< 
< [Peer]
< PublicKey = BRAVOPUBLICKEYBRAVOPUBLICKEYBRAVOPUBLICKEY0=
< Endpoint = 127.0.0.1:51820
< AllowedIPs = 10.99.0.2/32
< PersistentKeepalive = 5
< 
$ systemctl enable wg-quick@wg0
$ systemctl restart wg-quick@wg0
-- bravo --
$ hostname
$ hostname -f
$ curl -s -4 --max-time 5 ifconfig.me || curl -s -4 --max-time 5 icanhazip.com || true
$ which wg
$ apt update -qq
$ DEBIAN_FRONTEND=noninteractive apt install -y -qq wireguard wireguard-tools
$ modprobe wireguard || true
$ wg show wg0 dump 2>/dev/null || true
$ cat > /etc/wireguard/wg0.conf && chmod 600 /etc/wireguard/wg0.conf
< [Interface]
< Address = 10.99.0.2/16
< ListenPort = 51820
< PrivateKey = BRAVOPRIVATEKEYBRAVOPRIVATEKEYBRAVOPRIVATE0=
< PostUp = ip route add 192.168.10.0/24 via 10.99.0.1 dev %i || true
< PreDown = ip route del 192.168.10.0/24 via 10.99.0.1 dev %i || true
< PostUp = sysctl -w net.ipv4.ip_forward=1
< 
< [Peer]
< PublicKey = ALPHAPUBLICKEYALPHAPUBLICKEYALPHAPUBLICKEY0=
< Endpoint = 127.0.0.1:51820
< AllowedIPs = 10.99.0.1/32, 192.168.10.0/24
< PersistentKeepalive = 5
< 
$ systemctl enable wg-quick@wg0
$ systemctl restart wg-quick@wg0
=== deploy, configured nodes ===
-- alpha --
$ hostname
$ hostname -f
$ curl -s -4 --max-time 5 ifconfig.me || curl -s -4 --max-time 5 icanhazip.com || true
$ which wg
$ wg show wg0 dump 2>/dev/null || true
$ cat > /etc/wireguard/wg0.conf && chmod 600 /etc/wireguard/wg0.conf
< [Interface]
< Address = 10.99.0.1/16
< ListenPort = 51820
< PrivateKey = ALPHAPRIVATEKEYALPHAPRIVATEKEYALPHAPRIVATE0=
< PostUp = sysctl -w net.ipv4.ip_forward=1
< 
< [Peer]
< PublicKey = BRAVOPUBLICKEYBRAVOPUBLICKEYBRAVOPUBLICKEY0=
< Endpoint = 127.0.0.1:51820
< AllowedIPs = 10.99.0.2/32
< PersistentKeepalive = 5
< 
$ wg set wg0 peer OLDPEERKEYOLDPEERKEYOLDPEERKEYOLDPEERKEY00= remove
$ wg set wg0 peer BRAVOPUBLICKEYBRAVOPUBLICKEYBRAVOPUBLICKEY0= endpoint 127.0.0.1:51820 allowed-ips 10.99.0.2/32 persistent-keepalive 5
$ ip route show dev wg0
$ ip route del 10.50.0.0/24 via 10.99.0.9 dev wg0 2>/dev/null || true
$ ip route del 192.168.10.0/24 dev wg0 2>/dev/null || true
$ sysctl -w net.ipv4.ip_forward=1 > /dev/null
$ ip -4 -o addr show to 192.168.10.0/24
$ ip route add 192.168.10.0/24 dev eth1 proto kernel scope link src 192.168.10.7
$ cat > /etc/wireguard/wg0.conf && chmod 600 /etc/wireguard/wg0.conf
< [Interface]
< Address = 10.99.0.1/16
< ListenPort = 51820
< PrivateKey = ALPHAPRIVATEKEYALPHAPRIVATEKEYALPHAPRIVATE0=
< PostUp = sysctl -w net.ipv4.ip_forward=1
< 
< [Peer]
< PublicKey = BRAVOPUBLICKEYBRAVOPUBLICKEYBRAVOPUBLICKEY0=
< Endpoint = 127.0.0.1:51820
< AllowedIPs = 10.99.0.2/32
< PersistentKeepalive = 5
< 
